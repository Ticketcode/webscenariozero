# Scenario Zero · variables de entorno (copiar a .env.local; nunca subir llaves al repositorio)

# Llave de la API de Anthropic: solo en el servidor. Sin ella el sitio usa las respuestas de respaldo.
ANTHROPIC_API_KEY=

# Modelo de EVE en la web (por defecto el mismo del proyecto EVE).
EVE_WEB_MODEL=claude-haiku-4-5-20251001

# Orígenes extra permitidos para /api/eve, separados por coma (el propio sitio ya está permitido).
SITE_ORIGINS=https://scenariozero.org

# Solicitudes de aliado (EVE y /aliados/solicitud). Hace falta al menos un canal; sin ninguno, en producción el envío falla y EVE
# muestra el contacto directo. El correo es el registro de cada lead (no hay base de datos).
# Correo con Resend (resend.com): llave y remitente de un dominio verificado.
RESEND_API_KEY=
LEAD_EMAIL_FROM=Scenario Zero <solicitudes@scenariozero.org>
LEAD_EMAIL_TO=operaciones@scenariozero.org
# Backoffice / alerta: webhook que recibe cada lead en JSON (Make, Zapier, n8n o un CRM). El payload trae `mensajeAlerta` y
# `alertaWhatsappA` para que la automatización avise por WhatsApp al comercial (Alex Vásquez, 3115062021 -> 573115062021).
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
LEAD_WHATSAPP_TO=573115062021
